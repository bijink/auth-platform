# Postgres
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DB_NAME
# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
# Redis
REDIS_URL=redis://HOST:PORT
# Time values accept: ms | s | m | h | d | w | y | (plain number = ms)
# JWT - Access
JWT_ACCESS_SECRET_KEY=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=1h
# JWT - Refresh
JWT_REFRESH_SECRET_KEY=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=2h
